# Required Aiven MySQL connection. Separate fields are recommended because they safely
# handle special characters in the password. Leave DATABASE_URL empty when using them.
DATABASE_URL=
MYSQL_HOST=mysql-your-service.aivencloud.com
MYSQL_PORT=25067
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-with-aiven-password
MYSQL_DATABASE=defaultdb
MYSQL_SSL_CA=C:/absolute/path/to/ca.pem

# Alternative: use one URL and leave the MYSQL_* connection fields empty.
# DATABASE_URL=mysql+pymysql://avnadmin:ENCODED_PASSWORD@HOST:PORT/defaultdb

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Initial administrator created only when both values are set.
BOOTSTRAP_ADMIN_EMAIL=admin@pkonek.ph
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Lumen Suite staging API. The key needs AI Chat and OCR grants.
LUMEN_API_BASE=https://api.staging.nonlive.lumen.bayanichain.tech
LUMEN_API_KEY=
LUMEN_API_SECRET=
# Optional: set the Lumen AI Chat instance ID. The PLP hackathon blank instance is configured
# by the behavioral context PKonek sends with every message.
LUMEN_INSTANCE_ID=

# Optional AI adapters. Installing requirements-ai.txt enables local CLIP/OCR.
ENABLE_CLIP=false
CLIP_MODEL=openai/clip-vit-base-patch32
ENABLE_OCR=false
TESSERACT_CMD=

# Scheduler/SLA defaults
SCHEDULER_ENABLED=true
SLA_WARNING_HOURS=4
AUTO_CLOSE_HOURS=72
